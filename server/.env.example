# ---- Server ----
NODE_ENV=development
SEED_DEMO_ADMIN=true
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# ---- Database ----
# Local: mongodb://127.0.0.1:27017/outfitcraft
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/outfitcraft
MONGO_URI=mongodb://127.0.0.1:27017/outfitcraft

# ---- Auth ----
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai
JWT_EXPIRES_IN=7d

# ---- Cloudinary (luu anh) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- OpenWeatherMap ----
OPENWEATHER_API_KEY=

# ---- Gemini (stylist ao) - de trong se tu dong dung rule-based ----
GEMINI_API_KEY=
# Tuy chon. Mac dinh: gemini-flash-lite-latest
GEMINI_MODEL=

# ---- Decart (thu do truc tiep) ----
# Key vinh vien dct_..., CHI dat o backend. De trong thi tinh nang bao chua san sang.
DECART_API_KEY=
# Toi da moi phien va tong moi user moi ngay (giay, toi thieu 10)
TRYON_MAX_SESSION_SECONDS=120
TRYON_DAILY_SECONDS=600

# ---- Email (quen mat khau) ----
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 (hoac 587), SMTP_PASS = App Password 16 ky tu
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Tuy chon, vd: "OutfitCraft <no-reply@outfitcraft.vn>" - de trong se dung SMTP_USER
SMTP_FROM=
# Trang web nhan link dat lai mat khau: ${FRONTEND_URL}/reset-password/<token>
FRONTEND_URL=http://localhost:3000
